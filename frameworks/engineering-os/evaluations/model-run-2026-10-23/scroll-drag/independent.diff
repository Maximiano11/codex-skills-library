 <!doctype html><html lang="pt-BR"><meta charset="utf-8"><title>Scroll e drag</title><style>body{font:18px system-ui;padding:20px}.list{height:180px;width:360px;overflow-y:auto;border:1px solid #444}.row{padding:20px;border-bottom:1px solid #aaa}.handle{touch-action:none;cursor:grab}button{font:inherit}</style><div class="list" aria-label="Itens"><div class="row"><button class="handle" aria-label="Mover item 1">↕</button><span>Item 1 com texto para leitura</span></div><div class="row"><button class="handle" aria-label="Mover item 2">↕</button><span>Item 2 com texto para leitura</span></div><div class="row"><button class="handle" aria-label="Mover item 3">↕</button><span>Item 3 com texto para leitura</span></div><div class="row"><button class="handle" aria-label="Mover item 4">↕</button><span>Item 4 com texto para leitura</span></div><div class="row"><button class="handle" aria-label="Mover item 5">↕</button><span>Item 5 com texto para leitura</span></div><div class="row"><button class="handle" aria-label="Mover item 6">↕</button><span>Item 6 com texto para leitura</span></div><div class="row"><button class="handle" aria-label="Mover item 7">↕</button><span>Item 7 com texto para leitura</span></div><div class="row"><button class="handle" aria-label="Mover item 8">↕</button><span>Item 8 com texto para leitura</span></div></div><script>
-const list=document.querySelector('.list');let row=null;
-list.addEventListener('pointerdown',e=>{e.preventDefault();row=e.target.closest('.row');if(row)list.setPointerCapture(e.pointerId)});
-list.addEventListener('pointerup',e=>{const target=document.elementFromPoint(e.clientX,e.clientY)?.closest('.row');if(row&&target&&row!==target)list.insertBefore(row,target);row=null});
+const list=document.querySelector('.list');let row=null;let pointerId=null;
+list.addEventListener('pointerdown',e=>{
+  const handle=e.target.closest('.handle');
+  if(!handle||!list.contains(handle)||e.button!==0||!e.isPrimary||pointerId!==null)return;
+  const candidate=handle.closest('.row');
+  if(!candidate)return;
+  e.preventDefault();
+  row=candidate;
+  pointerId=e.pointerId;
+  handle.focus();
+  list.setPointerCapture(pointerId);
+});
+function endDrag(){
+  const capturedId=pointerId;
+  row=null;
+  pointerId=null;
+  if(capturedId!==null&&list.hasPointerCapture(capturedId))list.releasePointerCapture(capturedId);
+}
+list.addEventListener('pointerup',e=>{
+  if(e.pointerId!==pointerId)return;
+  const target=document.elementFromPoint(e.clientX,e.clientY)?.closest('.row');
+  if(row&&target&&list.contains(target)&&row!==target)list.insertBefore(row,target);
+  endDrag();
+});
+list.addEventListener('pointercancel',e=>{if(e.pointerId===pointerId)endDrag()});
+list.addEventListener('lostpointercapture',e=>{if(e.pointerId===pointerId){row=null;pointerId=null}});
+
 list.addEventListener('keydown',e=>{const row=e.target.closest('.row');if(!row)return;if(e.key==='ArrowDown'&&row.nextElementSibling){e.preventDefault();list.insertBefore(row.nextElementSibling,row);row.querySelector('button').focus()}if(e.key==='ArrowUp'&&row.previousElementSibling){e.preventDefault();list.insertBefore(row,row.previousElementSibling);row.querySelector('button').focus()}});
 </script></html>
